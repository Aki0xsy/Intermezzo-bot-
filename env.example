# Скопируй этот файл в .env и заполни своими значениями
# Токен от @BotFather
BOT_TOKEN=123456789:AAE...

# ID администраторов, которым бот будет слать новые заявки (через запятую)
# Узнать свой ID: напиши @userinfobot или @getmyid_bot
ADMIN_IDS=123456789

# Минимальный и максимальный возраст
MIN_AGE=12
MAX_AGE=99

# Название и IP сервера (показываются в меню "О сервере")
SERVER_NAME=Minecraft Server
SERVER_IP=mc.example.com

# --- Хостинг с вебхуками (Railway/Render) ---
# Локально оставь 0. На хостинге: 1 + укажи публичный URL сервиса
USE_WEBHOOK=0
WEBHOOK_BASE_URL=https://твой-сервис.up.railway.app
WEBHOOK_SECRET=любой-длинный-секрет
PORT=8000

# --- Google Sheets ---
# ID из URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=19OQJBDyg12dQWbuDyeiyPOYBdkNQODQCHMCj83vtZqE
GOOGLE_SHEET_NAME=Sheet1
# GOOGLE_SERVICE_ACCOUNT_JSON — содержимое скачанного JSON (одна строка) ИЛИ путь к файлу
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Связь с модом на Minecraft-сервере ---
# Длинный случайный секрет; такой же вписывается в config/intermezzoauth-common.toml на сервере.
# Пусто = API для мода выключен. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
PLUGIN_API_TOKEN=
